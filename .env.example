# 首次部署：复制本文件为 .env；已有 .env 请保留，不要覆盖密码和授权码。
# 普通客户只需设置下面两个密码及授权码；免费模式的授权码可以留空。
# .env 包含私密信息，请勿提交到仓库或发送给他人。

# 【必填】数据库密码：建议用 openssl rand -hex 24 生成，避免特殊字符。
# 已有数据库不能只改此项，必须同步修改数据库角色密码。
POSTGRES_PASSWORD=
# 【必填】管理员初始密码：至少 12 个字符，建议与数据库密码不同。
# 仅在空数据库首次初始化时生效；已有管理员密码请在管理界面修改。
ADMIN_PASSWORD=
# 【按模式填写】付费模式填写有效授权码；服务端开启免费模式时可以留空。
# 含 $、# 或空格等字符时，请用英文单引号包围整个值。
LICENSE_KEY=

# 【已预填】授权服务地址，通常无需修改；免费模式也保留此地址。
LICENSE_SERVER_URL=https://tl.macacaaca.top
# 【已预填】小雅服务地址；变量名必须保持大写 XIAOYA_URL。
XIAOYA_URL=http://172.18.0.1:5678
# 【已预填】NanShare 服务地址；变量名必须保持大写 NANSHARE_URL。
NANSHARE_URL=http://172.18.0.1:8115

# 【可选】镜像标签，默认拉取最新版本。
IMAGE_TAG=latest
# 【可选】宿主机访问端口，默认 8097。
HTTP_PORT=8097
# 【可选】宿主机媒体目录，默认使用当前目录下的 media；目录必须存在。
# 使用默认值时，将 STRM、NFO 和海报等媒体文件放入 ./media。
MEDIA_PATH=./media
# 【可选】私有 CA 证书在容器内的路径；普通公共证书留空。
# 如需使用，将证书放在 secrets/license-ca.crt，并填 /run/secrets/license-ca.crt。
LICENSE_CA_FILE=
# 【可选】客户端可访问的本服务完整地址，按需填写自己的域名或地址。
PUBLIC_URL=
# 【可选】对外播放入口地址，通常留空。
PUBLIC_PLAYBACK_URL=
# 【可选】首次初始化的接口密钥，通常留空；如需使用请自行生成。
BOOTSTRAP_API_KEY=
# 【可选】后台媒体探测入口地址，通常留空。
PROBE_PLAYBACK_URL=

# 【可选】允许的容器媒体根目录，多个目录用冒号分隔；需同时配置对应挂载。
MEDIA_ROOTS=/media
