# Copy to .env; never commit .env or secrets/.
IMAGE_TAG=latest
HTTP_PORT=8097
MEDIA_PATH=./media
# Use random hexadecimal strings (URL-safe); ADMIN_PASSWORD needs >=12 characters.
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
# Obtain the endpoint and license from your license administrator.
LICENSE_SERVER_URL=
LICENSE_KEY=
# For private CA: put certificate in secrets/license-ca.crt and set this container path.
LICENSE_CA_FILE=
# Public client-facing service URL; fill with your own domain when needed.
PUBLIC_URL=
PUBLIC_PLAYBACK_URL=
BOOTSTRAP_API_KEY=
NANSHARE_URL=
XIAOYA_URL=
PROBE_PLAYBACK_URL=
