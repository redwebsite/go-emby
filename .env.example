# ============================================================
# go-emby 环境变量
#
# 首次部署：
#
#   cp .env.example .env
#
# .env 包含密码和授权信息，请勿提交到 Git 仓库。
# ============================================================


# 【必填】PostgreSQL 数据库密码
#
# 建议生成：
#
#   openssl rand -hex 24
#
POSTGRES_PASSWORD=


# 【必填】管理员初始密码
#
# 至少 12 个字符。
# 仅空数据库首次初始化时生效。
#
ADMIN_PASSWORD=


# 【可选】授权码
#
# 免费模式留空。
#
LICENSE_KEY=


# ============================================================
# 一般无需修改
# ============================================================

LICENSE_SERVER_URL=https://tl.macacaaca.top


# Docker 镜像标签
IMAGE_TAG=latest


# Web 访问端口
HTTP_PORT=8097


# go-emby 容器运行 UID/GID
#
# 默认 0:0，避免宿主机媒体目录为 root:root 755 时
# 刮削 NFO / 海报 / Still 出现 permission denied。
#
# 如需非 root 运行，请改成媒体目录实际所有者的 UID/GID，例如：
#
#   PUID=1000
#   PGID=1000
#
PUID=0
PGID=0


# ============================================================
# 可选配置
# ============================================================

# 私有 CA 证书在容器内的路径
LICENSE_CA_FILE=

# 客户端可访问的完整地址
PUBLIC_URL=

# 首次初始化 API Key
BOOTSTRAP_API_KEY=


# ============================================================
# 容器内部允许访问的媒体根目录
#
# 注意：
# 这里填写的是「容器内路径」，
# 不是 Ubuntu / NAS 本地真实路径。
#
# 本机媒体目录直接在 compose.yaml 的 volumes 中配置。
#
# 默认：
#
# MEDIA_ROOTS=/media
#
# 如果 compose.yaml 增加：
#
#   /movies
#   /tv
#   /anime
#
# 则改成：
#
# MEDIA_ROOTS=/media:/movies:/tv:/anime
# ============================================================

MEDIA_ROOTS=/media
